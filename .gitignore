# Keep config + code in git; never commit secrets or scratch.
*.tmp
*.pyc
__pycache__/
.env
config/secrets.json

# Per-machine runtime state and generated digests are never committed.
# `make init` recreates state/ locally; digests/sample.md is the format reference.
state/*
!state/.gitkeep
digests/*
!digests/.gitkeep
!digests/sample.md
